require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ClearPath' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ClearPathTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # Add MapLibre SPM only to the Pods project's maplibre-react-native target.
    # $MLRN.post_install also adds it to the user project, which causes a
    # signature file collision when xcodebuild processes both projects in the
    # workspace. MapLibre 6.x is a static XCFramework, so it only needs to be
    # linked from the Pods side — all symbols end up in libPods-ClearPath.a.
    pods_project = installer.pods_project
    mlrn_target = pods_project.targets.find { |t| t.name == "maplibre-react-native" }
    if mlrn_target
      $MLRN._add_spm_to_target(
        pods_project,
        mlrn_target,
        $MLRN_SPM_SPEC[:url],
        $MLRN_SPM_SPEC[:requirement],
        $MLRN_SPM_SPEC[:product_name]
      )
      pods_project.save
    end
  end
end
