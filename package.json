{
  "name": "clearpath",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "privacy-audit": "node scripts/privacy-audit.js",
    "sync-deflock": "python3 scripts/sync-deflock.py",
    "start": "react-native start"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/geolocation": "^3.3.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@reduxjs/toolkit": "^2.2.5",
    "react": "18.2.0",
    "react-native": "0.74.2",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^3.32.0",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.84",
    "@react-native/eslint-config": "0.74.84",
    "@react-native/metro-config": "0.74.84",
    "@react-native/typescript-config": "0.74.84",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "2.8.8",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "testMatch": ["**/src/__tests__/**/*.test.ts", "**/src/__tests__/**/*.test.tsx"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@reduxjs/toolkit|immer|reselect)/)"
    ]
  }
}
